# Environment Variables Example
# Copie este ficheiro para .env e preencha com os seus valores

# MASTER_CODE - Código master para acesso ao backoffice do blog
# Em produção, configure também no Netlify: Site settings → Build & deploy → Environment
VITE_MASTER_CODE=SEU_CODIGO_MASTER_AQUI

# Firebase Configuration (opcional)
VITE_FIREBASE_API_KEY=sua_api_key
VITE_FIREBASE_AUTH_DOMAIN=seu_projeto.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://seu_projeto.firebaseio.com
VITE_FIREBASE_PROJECT_ID=seu_project_id
VITE_FIREBASE_STORAGE_BUCKET=seu_projeto.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=seu_sender_id
VITE_FIREBASE_APP_ID=seu_app_id
